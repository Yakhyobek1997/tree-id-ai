# ===== DATABASE CONFIGURATION =====

# Database type: sqlite | postgresql | mongodb
DB_TYPE=mongodb

# ===== SQLite Configuration =====
# (Development uchun)
SQLITE_DB_PATH=data/database/trees.db

# ===== PostgreSQL Configuration =====
# (Production SQL uchun)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=tree_recognition

# Yoki to'liq connection string:
# POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/tree_recognition

# ===== MongoDB Configuration =====
# (Production NoSQL uchun - Recommended)

# Local MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=tree_recognition
MONGO_USERNAME=
MONGO_PASSWORD=

# MongoDB Atlas (Cloud) - To'liq connection string
# MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/tree_recognition?retryWrites=true&w=majority

# ===== Flask Configuration =====
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key

# ===== File Upload Configuration =====
UPLOAD_FOLDER=data/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB (bytes)
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif

# ===== Model Configuration =====
MODEL_PATH=data/models
FEATURE_EXTRACTION_METHOD=simple  # simple | advanced | deep_learning

# ===== CORS Configuration =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== Logging =====
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log

# ===== MULTI-VIEW TREE ANALYSIS =====
# Copy these settings to tree-recognition-system/.env (never to frontend env).
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=False
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
PLANTNET_TIMEOUT=30
# Decision thresholds are NOT measured accuracy or calibrated probabilities.
ANALYSIS_MIN_SCORE=0.80
ANALYSIS_MIN_MARGIN=0.15
# 5 x 10 MB files, plus multipart overhead. Each decoded image is limited to 24 MP.
MAX_UPLOAD_SIZE=54525952

